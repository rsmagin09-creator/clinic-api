        {
          "name": "02 График врача (рабочие дни)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/doctors/1/schedules"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const days = pm.response.json().data.map(s => s.weekday);",
                  "  const fmt = d => d.getFullYear() + \"-\" + String(d.getMonth() + 1).padStart(2, \"0\") + \"-\" + String(d.getDate()).padStart(2, \"0\");",
                  "  let d = new Date(); d.setDate(d.getDate() + 1);",
                  "  let work = null, off = null;",
                  "  for (let i = 0; i < 14; i++) {",
                  "    const wd = ((d.getDay() + 6) % 7) + 1;",
                  "    if (!work && days.includes(wd)) work = fmt(d);",
                  "    if (!off && !days.includes(wd)) off = fmt(d);",
                  "    d.setDate(d.getDate() + 1);",
                  "  }",
                  "  pm.collectionVariables.set(\"work_date\", work); pm.collectionVariables.set(\"off_date\", off);"
                ]
              }
            }
          ]
        },
